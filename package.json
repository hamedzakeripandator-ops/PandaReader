{
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "author": "",
  "build": {
    "appId": "com.pandareader.app",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      "bookmark-backgrounds",
      "build/icon.ico",
      "build/icon.png"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "productName": "PandaReader",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm",
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/@neslinesli93/qpdf-wasm/**/*",
      "**/node_modules/node-unrar-js/**/*",
      "electron/workers/**/*",
      "electron/services/**/*",
      "electron/logger.js"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PandaReader",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hamedzakeripandator-ops",
        "repo": "PandaReader"
      }
    ]
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "@tanstack/react-virtual": "^3.14.24",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.1",
    "konva": "^10.9.0",
    "lucide-react": "^1.61.0",
    "minisearch": "^7.2.0",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "pica": "^10.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.2",
    "zustand": "^5.0.15"
  },
  "description": "A modern offline comic and manga reader for desktop",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.0"
  },
  "keywords": [],
  "license": "ISC",
  "main": "electron/main.js",
  "name": "pandareader",
  "productName": "PandaReader",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dist": "vite build && electron-builder --win --x64",
    "electron": "electron .",
    "publish": "vite build && electron-builder --win --x64 --publish always"
  },
  "version": "1.0.2"
}