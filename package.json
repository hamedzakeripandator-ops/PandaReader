{
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "author": "",
  "build": {
    "appId": "com.comicreader.app",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "extraResources": [
      "bookmark-backgrounds"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "productName": "my-comic-reader",
    "win": {
      "arch": [
        "x64"
      ],
      "target": "nsis"
    }
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.0",
    "jszip": "^3.10.1",
    "konva": "^10.9.0",
    "lucide-react": "^1.61.0",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "perfect-freehand": "^1.2.3",
    "pica": "^10.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.2",
    "zustand": "^5.0.15"
  },
  "description": "A modern offline comic and manga reader for desktop",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.0"
  },
  "keywords": [],
  "license": "ISC",
  "main": "electron/main.js",
  "name": "my-comic-reader",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dist": "npm run build && electron-builder",
    "electron": "electron ."
  },
  "version": "1.0.0"
}
